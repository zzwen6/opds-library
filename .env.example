# ===== Docker Compose 部署（NAS）=====
# 用法：cp .env.example .env，至少修改 AUTH_PASSWORD、LIBRARY_HOST_PATH、
# DEPLOY_WEBHOOK_TOKEN，然后 docker compose up -d
# 推送后自动部署的完整步骤见 docs/DEPLOY.md

# 使用的镜像（Compose 不负责构建）。默认拉取 GHCR；本地构建时改成例如
# OPDS_IMAGE=opds-library:0.5.3
# DOUBAN_IMAGE=douban-book-api:zzwen6
OPDS_IMAGE=ghcr.io/zzwen6/opds-library:latest
DOUBAN_IMAGE=ghcr.io/zzwen6/douban-book-api:latest

# 登录账号（Web 与 OPDS 共用）。AUTH_PASSWORD 必须改掉，默认 changeme 不安全
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# 宿主机（NAS）上的书库目录与数据目录（数据库、封面）
LIBRARY_HOST_PATH=./library
DATA_HOST_PATH=./data
# douban-book-api 的缓存目录
DOUBAN_CACHE_HOST_PATH=./douban-cache

# 容器运行用户，需对 DATA_HOST_PATH（及启用整理时的 LIBRARY_HOST_PATH）有写权限
# 用 `id 你的用户名` 查看 NAS 上的 uid/gid
PUID=1000
PGID=1000

# 宿主机上暴露的端口
HTTP_PORT=8080

GOOGLE_BOOKS_API_KEY=
PAGE_SIZE=50
# 刮削自动写入阈值（ISBN 精确命中始终自动写入未锁定字段）
SCRAPE_AUTO_THRESHOLD=90
# 整理/改名功能，默认关闭。启用时还需把 /library 改为可写挂载，见 README
ORGANIZE_ENABLED=false
# ORGANIZE_TEMPLATE={author}/{series}/{title}.{ext}
# 文件监听（inotify/watchdog + 定时轮询兜底）。部分 NAS 挂载上 inotify 可能不可靠
WATCH_ENABLED=true
WATCH_POLL_SECONDS=300

# 豆瓣中文刮削（通过同一 Compose 里的 douban-book-api 服务）
DOUBAN_ENABLED=true
DOUBAN_API_URL=http://douban-book-api:3000
DOUBAN_TIMEOUT_SECONDS=15
DOUBAN_MIN_INTERVAL_SECONDS=3
DOUBAN_COVER_BROWSER_HEADERS=true

# ===== 自动部署（GitHub Actions → GHCR → Watchtower）=====
# 用 `openssl rand -hex 32` 生成一串足够长的随机令牌，填到这里，
# 并在 opds-library、douban-book-api 两个 GitHub 仓库的
# Settings → Secrets and variables → Actions 里设置同名同值的
# DEPLOY_WEBHOOK_TOKEN。另一个 secret DEPLOY_WEBHOOK_URL
# 填 Cloudflare Tunnel 的地址，例如 https://opds-deploy.example.com/v1/update
# 切勿把真实令牌提交进 Git。
DEPLOY_WEBHOOK_TOKEN=change-me-generate-with-openssl-rand-hex-32

# Watchtower 读取的 Docker 登录配置（用于拉取私有 GHCR 镜像）。
# 必须先在「运行 compose 的同一个用户」下执行：
#   echo TOKEN | docker login ghcr.io -u zzwen6 --password-stdin
# 群晖 Container Manager 通常是 root，文件在 /root/.docker/config.json
# DOCKER_CONFIG_JSON=/root/.docker/config.json

# ===== 本机开发（不用 Docker，python -m app.main）=====
# 应用会直接读取当前目录的 .env，此时改用下面这些变量：
# LIBRARY_PATH=./library
# DATA_PATH=./data
# DOUBAN_API_URL=http://127.0.0.1:3000
# HOST=0.0.0.0
# PORT=8080
